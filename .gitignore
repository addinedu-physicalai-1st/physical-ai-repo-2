# 모델 가중치 — ultralytics 가 첫 실행 시 자동 다운로드
service/ai-service/ai_service/models/*.pt
service/ai-service/ai_service/models/*.onnx
# repo root 의 ultralytics 자동 다운로드 (perception 등 첫 실행 시)
/yolov8*.pt
/yolo11*.pt
# eduarm 무궁화 perception 의 YOLO 가중치 (런치 CWD = controller/eduping-controller).
# scripts/install_models.py 가 미리 받아둔다 (ollama 사전 pull 과 동일).
controller/eduping-controller/*.pt

# OpenArm URDF mesh 자산 — xacro 에서 생성 (scripts/sync_openarm_assets.sh)
# 72MB 라 repo 에 안 넣음. portal-web 띄우기 전 한 번 sync 필요.
service/web-service/portal-web/public/openarm/meshes/

# Prismic 업로더 자격증명
scripts/prismic/.env

# rosbag 녹화 — scripts/record-gogoping.sh 출력
log/rosbags/
*.mcap
*.db3
