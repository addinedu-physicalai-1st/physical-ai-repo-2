# robot-ui 환경변수 — `cp .env.example .env` 후 값 채우기

# 출연 로봇 (eduping | gogoping | noriarm)
VITE_ROBOT=gogoping

# Control Service URL (proxy /api/* 의 target)
CONTROL_URL=http://localhost:8000

# 등하원 얼굴 인식 endpoint device token — server 의 ROBOT_DEVICE_TOKEN 과 같아야 함
VITE_ROBOT_TOKEN=dev-robot-token-change-me

# 음성/intent mock middleware 사용 여부 (Control 없이 띄울 때만 true)
# VITE_USE_MOCK=true
