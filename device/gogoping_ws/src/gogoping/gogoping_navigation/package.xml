<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gogoping_navigation</name>
  <version>0.1.0</version>
  <description>GogoPing Nav2 wrapper + Gazebo Harmonic 시뮬레이션 환경 (핑더가든 유치원).</description>
  <maintainer email="dev@pingdergarten.local">pingdergarten</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <!-- Gazebo 시뮬레이션 -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>vicpinky_description</exec_depend>
  <exec_depend>vicpinky_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Nav2 (도입 시 활성화) -->
  <!-- <exec_depend>nav2_bringup</exec_depend> -->
  <!-- <exec_depend>nav2_map_server</exec_depend> -->
  <!-- <exec_depend>nav2_amcl</exec_depend> -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
