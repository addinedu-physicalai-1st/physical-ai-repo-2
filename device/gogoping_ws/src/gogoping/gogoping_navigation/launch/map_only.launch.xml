<?xml version="1.0" ?>

<!--
  occupancy grid 만 RViz 에 띄우기 위한 launch.
  Nav2 / AMCL / 로봇은 띄우지 않는다. waypoint 좌표 측정용.

  사용:
    ros2 launch gogoping_navigation map_only.launch.xml
    # 다른 터미널에서:
    ros2 topic echo /initialpose
    # RViz: '2D Pose Estimate' 도구로 지도 위 클릭+드래그 → 화살표
    # → /initialpose 에 x, y, quaternion 발행됨
-->
<launch>
  <arg name="map" default="$(find-pkg-share gogoping_navigation)/maps/map.yaml"/>
  <arg name="rviz_config" default="$(find-pkg-share gogoping_navigation)/rviz/map_view.rviz"/>

  <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
    <param name="yaml_filename" value="$(var map)"/>
    <param name="use_sim_time" value="false"/>
  </node>

  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager"
        name="lifecycle_manager_map" output="screen">
    <param name="node_names" value="['map_server']"/>
    <param name="autostart" value="true"/>
    <param name="use_sim_time" value="false"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
        args="-d $(var rviz_config)"/>
</launch>
