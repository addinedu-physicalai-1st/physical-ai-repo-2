  <version>0.0.0</version>
  <description>Camera pan servo control via Arduino Uno serial bridge for gogoping (Pinky).</description>
  <maintainer email="wooliwooli91@gmail.com">Woolim Park</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
