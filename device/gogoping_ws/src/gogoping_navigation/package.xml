<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gogoping_navigation</name>
  <version>0.1.0</version>
  <description>
    GogoPing navigation: Nav2 + slam_toolbox launch wrappers, map, nav_graph,
    nav2 params, RViz configs, plus pure-Python graph loader/router utilities.
    (vicpinky_navigation 응용판 + shoppinkki_nav 식 Python 동거)
  </description>
  <maintainer email="dlrkdxor0821@gmail.com">Pingdergarten</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Python 그래프 로더용 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- pip / apt: python3-yaml -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
