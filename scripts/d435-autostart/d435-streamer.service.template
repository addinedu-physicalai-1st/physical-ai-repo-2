[Unit]
Description=EduPing D435 depth streamer (auto-start on USB plug)
# StopWhenUnneeded=yes 가 키 — udev rule 의 SYSTEMD_WANTS 가 빠지면 (USB unplug)
# 자동 stop. 따로 stop trigger 안 만들어도 됨.
StopWhenUnneeded=yes

[Service]
Type=simple
# 아래 placeholder 들은 install.sh 가 sed 로 치환. 이 템플릿을 systemctl 에 직접
# 먹이지 말 것 — 렌더링 결과만 /etc/systemd/system/d435-streamer.service 로 간다.
User=__USER__
Group=__GROUP__
Environment=HOME=__HOME__
# conda pdg python + ROS install 둘 다 source 한 뒤 streamer 실행.
# bash -c 로 감싸야 source 가 작동.
ExecStart=/bin/bash -c 'set +u; source /opt/ros/jazzy/setup.bash; source __REPO_ROOT__/controller/eduping-controller/install/setup.bash; exec __PYTHON__ -m eduarm.d435_depth_streamer --server-host 127.0.0.1'
# control-service 가 아직 안 떠있어도 streamer 의 reconnect backoff 가 알아서 처리.
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
