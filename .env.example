# Atlassian Confluence Cloud 인증 정보
# 1. https://id.atlassian.com/manage-profile/security/api-tokens 에서 토큰 생성
# 2. 이 파일을 .env 로 복사 후 값 채우기 (프로젝트 루트에 둔다)
#    cp .env.example .env
# 3. .env 는 .gitignore 로 제외됨

# Atlassian (Confluence sync)
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-api-token-here

# Database
DATABASE_URL=postgresql+asyncpg://pingder:pingder@localhost:5432/pingdergarten
TEST_DATABASE_URL=postgresql+asyncpg://pingder:pingder@localhost:5432/pingdergarten_test

# fastapi-users
SECRET=dev-secret-change-me
COOKIE_MAX_AGE=604800

# robot 디바이스 (등하원 얼굴 인식 endpoint 보호)
ROBOT_DEVICE_TOKEN=dev-robot-token-change-me
FACE_MATCH_THRESHOLD=0.45
