# 이 파일을 .env 로 복사 후 값 채우기 (프로젝트 루트). .env 는 .gitignore 됨.
#   cp .env.example .env
#
# 여기에 적힌 키만 환경변수로 override 된다. 그 외 모든 튜닝 노브 (쿠키 수명, 얼굴
# 매칭 임계값, Ollama / Edge TTS 설정 등) 는 server/{ai,control}/config.py 의
# Settings 클래스 안에 코드 기본값으로 박혀 있으니, 바꿔야 하면 그 파일을 직접 수정한다.

# Atlassian Confluence Cloud (docs sync) — scripts/_sync_docs/* 가 직접 os.environ 으로 읽음.
# 토큰 발급: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-api-token-here

# DB. 테스트는 같은 인스턴스에 DB 이름 + `_test` 를 붙여 자동 생성/삭제한다.
DATABASE_URL=postgresql+asyncpg://pingder:pingder@localhost:5432/pingdergarten

# fastapi-users 세션 서명 비밀
SECRET=dev-secret-change-me

# 등하원 얼굴 인식 endpoint 보호 (robot 디바이스 ↔ Control)
ROBOT_DEVICE_TOKEN=dev-robot-token-change-me
