# Atlassian Confluence Cloud 인증 정보
# 1. https://id.atlassian.com/manage-profile/security/api-tokens 에서 토큰 생성
# 2. 이 파일을 .env 로 복사 후 값 채우기 (프로젝트 루트에 둔다)
#    cp .env.example .env
# 3. .env 는 .gitignore 로 제외됨

# Atlassian (Confluence sync)
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-api-token-here

# Database
DATABASE_URL=postgresql+asyncpg://pingder:pingder@localhost:5432/pingdergarten
TEST_DATABASE_URL=postgresql+asyncpg://pingder:pingder@localhost:5432/pingdergarten_test

# fastapi-users
SECRET=dev-secret-change-me
COOKIE_MAX_AGE=604800

# robot 디바이스 (등하원 얼굴 인식 endpoint 보호)
ROBOT_DEVICE_TOKEN=dev-robot-token-change-me
FACE_MATCH_THRESHOLD=0.45

# AI Hub LLM latency tuning
# 의도 분류는 가벼운 모델, 잡담(chat)은 품질용으로 더 큰 모델 권장. chat 모델은 `ollama pull` 로 받아야 함.
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_CLASSIFY_NUM_PREDICT=28
OLLAMA_CLASSIFY_NUM_CTX=768
# Chat JSON(reply+emotion) — 너무 낮으면 잘림·파싱 실패, 너무 높으면 생성 상한만 늘어남(보통 EOS 로 일찍 끝남).
OLLAMA_CHAT_NUM_PREDICT=156
OLLAMA_CHAT_NUM_CTX=512
OLLAMA_CHAT_TEMPERATURE=0.4
OLLAMA_CHAT_TOP_P=0.88
# 0 이면 Ollama 에 top_k 를 보내지 않음(품질 우선).
OLLAMA_CHAT_TOP_K=40
OLLAMA_CHAT_USE_FEW_SHOT=false
# Chat 읽기 타임아웃(초) — 짧을수록 빠른 실패·repair 전환. 타임아웃이 잦으면 4.5~5.5 로.
OLLAMA_CHAT_TIMEOUT_S=4.15
# 잡담(chat) Ollama 응답이 이 시간(초)을 넘기면 선생님 안내 문구로 대체(기본 2). 0 이면 비활성.
VOICE_CHAT_LLM_MAX_WAIT_S=2
# Ollama: keep model loaded after each /api/chat (reduces reload latency). See Ollama API `keep_alive`.
OLLAMA_KEEP_ALIVE=30m
# Hub startup: background preload for classify+chat models (needs Ollama running).
OLLAMA_WARMUP_ON_START=false
# Cache registered-child label list from DB (seconds). 0 = always hit DB.
ROSTER_LABELS_CACHE_TTL_S=120

# TTS (AI Hub /voice/tts) — Edge neural MP3, 인터넷 필요
# EDGE_TTS_VOICE=ko-KR-InJoonNeural
# EDGE_TTS_PITCH_PCT=+3.5st
# 실제로는 edge-tts 가 +NNHz 로 변환해 적용한다. 직접 Hz: EDGE_TTS_PITCH_PCT=+110Hz
# (더 높게) +4.5st / +12% / +120Hz — 과하면 찢어짐
# EDGE_TTS_RATE=+14%  말 빠르기(기본). 더 빠르게는 +16% 까지, 과하면 찢어짐.
# (다른 남성) ko-KR-HyunsuMultilingualNeural — EDGE_TTS_PITCH_PCT= 로 미세 조정
