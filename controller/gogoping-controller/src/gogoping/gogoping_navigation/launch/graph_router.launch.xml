<?xml version="1.0" ?>

<!--
  graph_router_node 만 단독 실행 (Nav2 / 로봇 / 시뮬은 별도 launch).
  사용:
    ros2 launch gogoping_navigation graph_router.launch.xml
    ros2 service call /graph_router/route gogoping_msgs/srv/RouteToVertex \
        "{target_name: '충전소', start: {x: 0.0, y: 0.0, z: 0.0}}"
-->

<launch>
  <arg name="waypoints_yaml"
       default="$(find-pkg-share gogoping_navigation)/config/waypoints.yaml"/>
  <arg name="lanes_yaml"
       default="$(find-pkg-share gogoping_navigation)/config/lanes.yaml"/>
  <arg name="follow_action" default="/navigate_to_pose"/>
  <arg name="frame_id" default="map"/>
  <arg name="base_frame" default="gogoping/base_link"/>
  <!-- 시연/디버그 토글 — NO_PROXIMITY_SAFETY=1 이면 device 스크립트가 true 로 전달.
       true 면 graph_router 가 사람/벽 근접 정지·reroute·후진 분기를 skip. -->
  <arg name="disable_proximity_safety" default="false"/>

  <node pkg="gogoping_navigation" exec="graph_router_node"
        name="graph_router" output="screen">
    <param name="waypoints_yaml" value="$(var waypoints_yaml)"/>
    <param name="lanes_yaml" value="$(var lanes_yaml)"/>
    <param name="follow_action" value="$(var follow_action)"/>
    <param name="frame_id" value="$(var frame_id)"/>
    <param name="base_frame" value="$(var base_frame)"/>
    <param name="disable_proximity_safety" value="$(var disable_proximity_safety)"/>
  </node>
</launch>
