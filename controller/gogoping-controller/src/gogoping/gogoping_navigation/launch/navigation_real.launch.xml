<?xml version="1.0" ?>
<!--
  실물 노트북용 nav2 navigation stack — controller + planner + smoother +
  behavior + bt_navigator + waypoint_follower + velocity_smoother + lifecycle_manager_navigation.

  목적: graph_router 가 vertex 단위로 호출하는 /navigate_to_pose action server 를
  제공해 admin-ui 의 웨이포인트 클릭이 실제 로봇 이동까지 이어지게 함.

  전제 (별도로 떠 있어야 함):
   * localization_real.launch.xml — map_server + AMCL + lifecycle_manager_localization
   * Pi 의 device-gogoping-pi.sh — vicpinky_bringup (/gogoping/odom, /gogoping/scan,
     /gogoping/cmd_vel subscribe, /tf 발행)
   * gogoping_modes — graph_router 와 BT

  sim_with_nav2.launch.xml 과의 차이:
   * gazebo include 없음 (실 로봇)
   * map_server + AMCL 없음 (localization_real.launch.xml 이 담당)
   * use_sim_time = False
   * frame_id 들 namespace 없음 (vicpinky_bringup 가 root frame 사용)

  토픽 경로 (모두 절대):
   * controller_server cmd_vel out → /gogoping/cmd_vel_nav
   * velocity_smoother cmd_vel in   → /gogoping/cmd_vel_nav
   * velocity_smoother cmd_vel out  → /gogoping/cmd_vel_raw
   * safety_filter cmd_vel_raw      → /gogoping/cmd_vel (vicpinky_bringup 가 subscribe)

  사용:
    ros2 launch gogoping_navigation navigation_real.launch.xml
    # 또는 device-gogoping-laptop.sh 의 nav2 window 가 자동 호출
-->
<launch>
    <arg name="params_file"
         default="$(find-pkg-share gogoping_navigation)/params/nav2_params_real.yaml"/>
    <arg name="use_sim_time" default="false"/>
    <arg name="autostart" default="true"/>
    <arg name="log_level" default="info"/>

    <!-- controller_server — cmd_vel out 을 /gogoping/cmd_vel_nav 로 (velocity_smoother 가 받음) -->
    <node pkg="nav2_controller" exec="controller_server" name="controller_server"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <remap from="cmd_vel" to="/gogoping/cmd_vel_nav"/>
    </node>

    <node pkg="nav2_planner" exec="planner_server" name="planner_server"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- smoother_server — BT 의 SmoothPath(SimpleSmoother)가 호출. planner 출력 경로 평활.
         BT(navigate_to_pose_3hz_replan.xml)가 이 노드를 쓰므로 반드시 떠 있어야 함. -->
    <node pkg="nav2_smoother" exec="smoother_server" name="smoother_server"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <node pkg="nav2_behaviors" exec="behavior_server" name="behavior_server"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <!-- 커스텀 BT — RateController hz="3.0" 으로 replan 주기 1Hz → 3Hz 상향.
             graph_router 가 NavigateToPose 를 vertex 단위 chain 호출하므로 이 BT 가
             실제로 사용됨. -->
        <param name="default_nav_to_pose_bt_xml"
               value="$(find-pkg-share gogoping_navigation)/behavior_trees/navigate_to_pose_3hz_replan.xml"/>
    </node>

    <node pkg="nav2_waypoint_follower" exec="waypoint_follower"
          name="waypoint_follower" output="screen"
          args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- velocity_smoother — controller cmd_vel_nav → /gogoping/cmd_vel_raw (safety_filter 가 relay) -->
    <node pkg="nav2_velocity_smoother" exec="velocity_smoother"
          name="velocity_smoother" output="screen"
          args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <remap from="cmd_vel" to="/gogoping/cmd_vel_nav"/>
        <remap from="cmd_vel_smoothed" to="/gogoping/cmd_vel_raw"/>
    </node>

    <!-- safety_filter — /gogoping/cmd_vel_raw → /gogoping/cmd_vel relay.
         velocity_smoother 출력(cmd_vel_raw)을 vicpinky 가 받는 cmd_vel 로 전달하는 필수 노드.
         perception(safety_monitor) 기동 시 /gogoping/safety_stop 으로 정지 gating,
         미기동 시 safety_stop=false 기본값이라 순수 패스스루. perception 과 독립적으로
         nav 와 항상 함께 떠야 주행 가능 — 과거 perception.launch.py 에만 있어 perception
         미기동 시 로봇이 cmd_vel 을 못 받던 문제 수정. lifecycle 노드 아님(아래 매니저 제외). -->
    <node pkg="gogoping_perception" exec="safety_filter"
          name="gogoping_safety_filter" output="screen"/>

    <!-- lifecycle_manager_navigation — 위 6 노드 autostart -->
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager"
          name="lifecycle_manager_navigation" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="autostart" value="$(var autostart)"/>
        <param name="node_names" value="['controller_server',
                                         'planner_server',
                                         'smoother_server',
                                         'behavior_server',
                                         'bt_navigator',
                                         'waypoint_follower',
                                         'velocity_smoother']"/>
    </node>
</launch>
