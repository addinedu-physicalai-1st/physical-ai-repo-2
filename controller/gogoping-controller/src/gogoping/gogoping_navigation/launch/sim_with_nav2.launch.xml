<?xml version="1.0" ?>
<!--
  핑더가든 sim + Vic Pinky + nav2 풀스택.

  launch_sim_with_pinky.launch.xml (gazebo + Pinky spawn + 토픽 bridge) +
  nav2 (map_server + AMCL + planner + controller + behavior + bt_navigator +
  waypoint_follower + velocity_smoother + costmap) 를 한 번에 띄운다.

  TF tree (예상):
    map  → gogoping/odom            (AMCL 발행)
         → gogoping/base_footprint  (gazebo odom plugin → /tf)
         → gogoping/base_link       (URDF static)
         → gogoping/lidar, camera, …

  WaypointsRosBridge (service/control-service/control_service/waypoints/ros_bridge.py) 가 이 transform 을
  lookup 하여 map frame 의 정확한 로봇 pose 를 얻는다.

  주의:
   * Gazebo `ros_gz_bridge` 가 /tf 를 root namespace 로 발행하므로 nav2 노드도
     root namespace 에서 띄우고, 토픽은 /gogoping/* 절대경로로 지정한다
     (vicpinky_navigation/launch/bringup_launch.xml 의 push-ros-namespace +
     /tf→tf remap 패턴은 여기서 쓰지 않는다).
   * laser_filters 가 /gogoping/scan → /gogoping/scan_filtered 를 생성.
-->
<launch>
    <arg name="namespace" default="gogoping"/>
    <arg name="world_name" default="world.sdf"/>
    <!-- world: 절대경로 직접 전달용 (.world / .sdf 후보 swap). 미지정 시 world_name 으로 share 내부 해석. -->
    <arg name="world" default="$(find-pkg-share gogoping_navigation)/worlds/$(var world_name)"/>
    <arg name="map" default="$(find-pkg-share gogoping_navigation)/maps/new_map.yaml"/>
    <!-- Pinky spawn pose (world frame ≈ map frame). AMCL initial_pose (nav2_params_sim.yaml)
         와 일치시켜 spawn 위치 = localization 추정 위치가 되게 한다. -->
    <arg name="spawn_x" default="0.2796"/>
    <arg name="spawn_y" default="12.0307"/>
    <arg name="spawn_z" default="0.10"/>
    <arg name="spawn_yaw" default="-1.5708"/>   <!-- -90° — map 기준 아래쪽(-Y) 방향 -->

    <arg name="params_file"
         default="$(find-pkg-share gogoping_navigation)/params/nav2_params_sim.yaml"/>
    <arg name="laser_filter_params"
         default="$(find-pkg-share gogoping_navigation)/params/laser_filter_sim.yaml"/>
    <arg name="use_sim_time" default="true"/>
    <arg name="autostart" default="true"/>
    <arg name="log_level" default="info"/>
    <!-- laser_filters 가 설치돼 있을 때만 true 로 (ros-jazzy-laser-filters).
         false 면 nav2 가 raw /gogoping/scan 직접 사용 (rear pillar 가
         self-scan 으로 costmap 에 가짜 obstacle 로 잡힘). -->
    <arg name="use_laser_filter" default="true"/>

    <!-- 1) gazebo + Vic Pinky spawn -->
    <include file="$(find-pkg-share gogoping_navigation)/launch/launch_sim_with_pinky.launch.xml">
        <arg name='namespace' value='$(var namespace)'/>
        <arg name='world_name' value='$(var world_name)'/>
        <arg name='world' value='$(var world)'/>
        <arg name='spawn_x' value='$(var spawn_x)'/>
        <arg name='spawn_y' value='$(var spawn_y)'/>
        <arg name='spawn_z' value='$(var spawn_z)'/>
        <arg name='spawn_yaw' value='$(var spawn_yaw)'/>
    </include>

    <!-- 2) laser_filters: /gogoping/scan → /gogoping/scan_filtered
         (vicpinky_bringup/config/laser_filter.yaml 의 sim 버전 사용)
         use_laser_filter:=true 이고 ros-jazzy-laser-filters 가 설치된 경우에만 활성. -->
    <group if="$(var use_laser_filter)">
        <node pkg="laser_filters" exec="scan_to_scan_filter_chain"
              name="scan_to_scan_filter_chain"
              namespace="$(var namespace)" output="screen">
            <param from="$(var laser_filter_params)"/>
            <param name="use_sim_time" value="$(var use_sim_time)"/>
        </node>
    </group>

    <!-- 3) nav2 stack — root namespace, topics 절대경로 사용.
            (push-ros-namespace 안 함 → /tf 가 global 그대로) -->

    <!-- 3a) map_server -->
    <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen"
          args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="yaml_filename" value="$(var map)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- 3b) AMCL — scan_topic 은 params 에서 /gogoping/scan_filtered 로 설정됨 -->
    <node pkg="nav2_amcl" exec="amcl" name="amcl" output="screen"
          args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- 3c) lifecycle manager (localization) -->
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager"
          name="lifecycle_manager_localization" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="autostart" value="$(var autostart)"/>
        <param name="node_names" value="['map_server', 'amcl']"/>
    </node>

    <!-- 3d) controller_server -->
    <node pkg="nav2_controller" exec="controller_server" name="controller_server"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <remap from="cmd_vel" to="/gogoping/cmd_vel_nav"/>
    </node>

    <!-- 3e) planner_server -->
    <node pkg="nav2_planner" exec="planner_server" name="planner_server"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- 3e-2) smoother_server — BT 의 SmoothPath(SimpleSmoother)가 호출. 경로 평활.
         BT(navigate_to_pose_3hz_replan.xml)가 이 노드를 쓰므로 반드시 떠 있어야 함. -->
    <node pkg="nav2_smoother" exec="smoother_server" name="smoother_server"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- 3f) behavior_server -->
    <node pkg="nav2_behaviors" exec="behavior_server" name="behavior_server"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- 3g) bt_navigator -->
    <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <!-- 커스텀 BT — RateController hz="3.0" 으로 replan 주기 1Hz → 3Hz 상향 -->
        <param name="default_nav_to_pose_bt_xml"
               value="$(find-pkg-share gogoping_navigation)/behavior_trees/navigate_to_pose_3hz_replan.xml"/>
    </node>

    <!-- 3h) waypoint_follower -->
    <node pkg="nav2_waypoint_follower" exec="waypoint_follower"
          name="waypoint_follower" output="screen"
          args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- 3h-2) collision_monitor — LiDAR stop zone 으로 nav2 주행 cmd_vel gate (사물 충돌 안전망).
         controller(cmd_vel_nav) → collision_monitor → cmd_vel_nav_safe → velocity_smoother.
         FOLLOW reactive(cmd_vel_raw 직접)는 우회. topic 은 params 에서 절대경로 지정. -->
    <node pkg="nav2_collision_monitor" exec="collision_monitor" name="collision_monitor"
          output="screen" args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- 3i) velocity_smoother — cmd_vel_nav_safe(collision gate 후) → /gogoping/cmd_vel_raw (safety_filter 가 relay) -->
    <node pkg="nav2_velocity_smoother" exec="velocity_smoother"
          name="velocity_smoother" output="screen"
          args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <remap from="cmd_vel" to="/gogoping/cmd_vel_nav_safe"/>
        <remap from="cmd_vel_smoothed" to="/gogoping/cmd_vel_raw"/>
    </node>

    <!-- 3i-2) safety_filter — /gogoping/cmd_vel_raw → /gogoping/cmd_vel relay.
         velocity_smoother 출력(cmd_vel_raw)을 로봇이 받는 cmd_vel 로 전달하는 필수 노드.
         perception(safety_monitor)이 떠 있으면 /gogoping/safety_stop 으로 정지 gating,
         안 떠 있으면 safety_stop=false 기본값이라 순수 패스스루. perception 과 독립적으로
         nav 와 항상 함께 떠야 주행 가능 — 과거 perception.launch.py 에만 있어 perception
         미기동 시 로봇이 cmd_vel 을 못 받던 문제 수정. -->
    <node pkg="gogoping_perception" exec="safety_filter"
          name="gogoping_safety_filter" output="screen"/>

    <!-- 3j) lifecycle manager (navigation) -->
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager"
          name="lifecycle_manager_navigation" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="autostart" value="$(var autostart)"/>
        <param name="node_names"
               value="['controller_server', 'planner_server', 'smoother_server',
                       'behavior_server', 'bt_navigator', 'waypoint_follower',
                       'collision_monitor', 'velocity_smoother']"/>
    </node>
</launch>
