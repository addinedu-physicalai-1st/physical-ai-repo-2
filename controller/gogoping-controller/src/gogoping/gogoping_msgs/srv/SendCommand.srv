# [DEPRECATED — 2026-05-17] 새 코드는 srv/SetGoal.srv 를 사용한다.
#
# 본 srv 는 trigger-based 인터페이스로, UI 가 FSM 의 trigger 이름을 직접 전달했다.
# Goal-based 로 리팩터링 (UI 가 원하는 mode/task 만 명시, trigger 발화는 robot 내부 책임)
# 하면서 SetGoal.srv 로 교체. 본 srv 는 호환을 위해 남겨두지만 신규 client/server 작성 금지.
#
# UI / Control Server → gogoping_modes 명령 인터페이스 (legacy)
#
# command / task / 등 필드의 의미와 매핑은
# controller/gogoping-controller/docs/fsm-triggers.md 참조.
#
# 예시:
#   command="assist_command", task="carry",   carry_mode="goto",   destination_key="kitchen_door"
#   command="assist_command", task="carry",   carry_mode="follow", target_id="teacher_kim"   # 운반+추종
#   command="assist_command", task="follow",  target_id="teacher_kim"                        # 단독 추종
#   command="assist_command", task="lullaby"
#   command="play_command",   task="hideseek"      # 1회 실행 후 종료
#   command="cancel"
#   command="return_command"
#   command="reset"

string command          # "assist_command" / "play_command" / "cancel" / "return_command" / "reset"
string task             # "carry" / "follow" / "lullaby" / "hideseek"  (assist_command/play_command 시)
string carry_mode       # "manual" / "goto" / "follow"                  (task=carry 시)
string destination_key  # carry+goto 시 named_pose 키
string target_id        # follow / hide-and-seek 대상 식별자 (child_id 또는 teacher_id)
---
bool accepted           # FSM 이 현재 state 에서 trigger 수락했는지
string reason           # accepted=false 일 때 사유 (invalid_trigger / missing_task / ...)
