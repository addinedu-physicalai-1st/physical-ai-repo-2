# UI / Control Server → gogoping_modes goal 설정 인터페이스.
#
# Goal-based 아키텍처의 단일 진입점.
# command_listener 가 본 srv 의 server 가 되어:
#   1) Goal validation (mode/task 조합이 valid 한지)
#   2) blackboard.current_goal 세팅
#   3) 현재 state ↔ goal 차이 비교 후 적절한 FSM trigger 자체 발화
#      (assist_request / play_request / cancel / return_request / manual_request 등)
#
# 같은 goal 재호출 = 무해. 다른 goal 호출 = preempt.
#
# UI 는 본 srv 만 호출하면 됨 — FSM trigger 이름은 internal API 로 외부에 노출 안 됨.
# 자세한 Goal 의미: msg/Goal.msg 참조.
#
# (Note) 기존 srv/SendCommand.srv 는 deprecated — 새 코드는 본 srv 사용.

gogoping_msgs/Goal goal
---
bool accepted          # validation 통과 + goal 수락 여부
string reason          # accepted=false 시 사유:
                       #   "invalid_mode" — mode 가 IDLE/ASSIST/PLAY/RETURNING 외
                       #   "missing_task" — mode=ASSIST/PLAY 인데 task 비어있음
                       #   "invalid_task_for_mode" — task 가 mode 와 안 맞음 (예: ASSIST+hideseek)
                       #   "missing_destination" — task=goto 인데 destination_key 비어있음
                       #   "missing_target_id" — follow / hideseek 인데 target_id 비어있음
                       #   "fsm_in_charging" — CHARGING 상태에서 ASSIST/PLAY/RETURNING 요청
                       #                       (battery_full 으로 IDLE 진입 대기 필요)
