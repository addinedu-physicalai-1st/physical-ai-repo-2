# vertex 이름 한 번 받아 다익스트라 경로 따라 nav2 FollowWaypoints 로 이동.
# graph_router_node 가 액션 서버 노출, 내부에서 nav2_msgs/action/FollowWaypoints 호출.

# goal
string target_name        # 목적지 vertex name
---
# result
bool success
string message            # 실패 사유 (no_path / nav2_failed / canceled 등)
string final_vertex       # 실제 도착한 vertex name (취소/실패 시 마지막 통과 vertex)
---
# feedback
string current_vertex     # 마지막으로 통과한 vertex name
uint32 sequence_index     # 시퀀스 안에서의 인덱스 (0-based)
uint32 sequence_total     # 전체 vertex 갯수
float32 progress          # 0.0 ~ 1.0 (단순히 sequence_index / (sequence_total - 1))
